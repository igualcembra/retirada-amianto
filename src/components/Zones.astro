<style>
  .zones-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .zone-card {
    background: white;
    padding: 1rem;
    border-radius: 0.5rem;
    border: 2px solid var(--color-border);
    transition: all 0.3s ease;
    text-align: center;
  }

  .zone-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(14, 165, 233, 0.2);
  }

  .zone-title {
    font-size: 0.9375rem;
    color: var(--color-primary);
    margin: 0;
    font-weight: 600;
  }

  .zone-card-link {
    text-decoration: none;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .zone-card-link:hover {
    background: var(--color-primary);
    transform: translateY(-2px);
  }

  .zone-card-link:hover .zone-title {
    color: white;
  }

  .zone-arrow {
    color: var(--color-primary);
    opacity: 0;
    transform: translateX(-5px);
    transition: all 0.3s ease;
  }

  .zone-card-link:hover .zone-arrow {
    opacity: 1;
    transform: translateX(0);
    color: white;
  }

  .coverage-notice {
    text-align: center;
    padding: 2.5rem;
    background: white;
    border-radius: 1rem;
    border: 2px dashed var(--color-border);
  }

  .coverage-notice p {
    font-size: 1.125rem;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  @media (max-width: 1024px) {
    .zones-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 768px) {
    .zones-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
    }

    .zone-card {
      padding: 0.75rem;
    }

    .zone-title {
      font-size: 0.875rem;
    }

    .coverage-notice {
      padding: 2rem 1.5rem;
    }

    .coverage-notice p {
      font-size: 1rem;
    }
  }
</style>
