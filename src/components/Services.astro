---
---

<section id="servicios" class="section section-alt">
  <div class="container">
    <div class="section-header text-center">
      <h2 class="section-title">Nuestros Servicios de Desamiantado</h2>
      <p class="section-subtitle">
        Soluciones profesionales para todo tipo de estructuras con amianto
      </p>
    </div>

    <div class="grid grid-3">
      <div class="service-card">
        <div class="service-image">
          <img
            src="https://images.unsplash.com/photo-1632778149955-e80f8ceca2e8?w=800&auto=format&fit=crop&q=80"
            alt="Tejado industrial de uralita"
            loading="lazy"
          />
        </div>
        <div class="service-content">
          <h3 class="service-title">Retirada de Tejados de Uralita</h3>
          <p class="service-description">
            Desmontaje seguro de cubiertas de fibrocemento en naves industriales, agrícolas y viviendas. Incluye retirada, embalaje y gestión de residuos.
          </p>
          <ul class="service-includes">
            <li>Inspección previa</li>
            <li>Desmontaje sin roturas</li>
            <li>Embalaje homologado</li>
            <li>Certificado final</li>
          </ul>
        </div>
      </div>

      <div class="service-card">
        <div class="service-image">
          <img
            src="https://images.unsplash.com/photo-1581094794329-c8112a89af12?w=800&auto=format&fit=crop&q=80"
            alt="Depósito industrial"
            loading="lazy"
          />
        </div>
        <div class="service-content">
          <h3 class="service-title">Depósitos de Fibrocemento</h3>
          <p class="service-description">
            Retirada de depósitos de agua con amianto, tanto aéreos como enterrados. Trabajo especializado con maquinaria específica.
          </p>
          <ul class="service-includes">
            <li>Vaciado y limpieza previa</li>
            <li>Corte y extracción segura</li>
            <li>Transporte especializado</li>
            <li>Gestión documental</li>
          </ul>
        </div>
      </div>

      <div class="service-card">
        <div class="service-image">
          <img
            src="https://images.unsplash.com/photo-1621905251189-08b45d6a269e?w=800&auto=format&fit=crop&q=80"
            alt="Instalaciones industriales"
            loading="lazy"
          />
        </div>
        <div class="service-content">
          <h3 class="service-title">Tuberías y Conducciones</h3>
          <p class="service-description">
            Eliminación de tuberías de fibrocemento en instalaciones industriales, saneamientos y conducciones de agua.
          </p>
          <ul class="service-includes">
            <li>Detección y análisis</li>
            <li>Confinamiento de zona</li>
            <li>Extracción controlada</li>
            <li>Sellado final</li>
          </ul>
        </div>
      </div>

      <div class="service-card">
        <div class="service-image">
          <img
            src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=800&auto=format&fit=crop&q=80"
            alt="Fachada de edificio"
            loading="lazy"
          />
        </div>
        <div class="service-content">
          <h3 class="service-title">Fachadas y Revestimientos</h3>
          <p class="service-description">
            Retirada de placas de amianto en fachadas, revestimientos interiores y falsos techos en edificios.
          </p>
          <ul class="service-includes">
            <li>Protección de áreas colindantes</li>
            <li>Desmontaje por secciones</li>
            <li>Limpieza profunda</li>
            <li>Certificado de salubridad</li>
          </ul>
        </div>
      </div>

      <div class="service-card">
        <div class="service-image">
          <img
            src="https://images.unsplash.com/photo-1590856029620-23e5c4891952?w=800&auto=format&fit=crop&q=80"
            alt="Trabajador con equipo de protección"
            loading="lazy"
          />
        </div>
        <div class="service-content">
          <h3 class="service-title">Encapsulado de Amianto</h3>
          <p class="service-description">
            Alternativa cuando la retirada no es viable. Sellado profesional para evitar liberación de fibras.
          </p>
          <ul class="service-includes">
            <li>Evaluación técnica</li>
            <li>Aplicación de sellante</li>
            <li>Control de calidad</li>
            <li>Plan de mantenimiento</li>
          </ul>
        </div>
      </div>

      <div class="service-card">
        <div class="service-image">
          <img
            src="https://images.unsplash.com/photo-1581093458791-9d42e3c540f5?w=800&auto=format&fit=crop&q=80"
            alt="Inspector técnico"
            loading="lazy"
          />
        </div>
        <div class="service-content">
          <h3 class="service-title">Inspección y Análisis</h3>
          <p class="service-description">
            Identificación y análisis de materiales sospechosos. Informe técnico con recomendaciones y presupuesto.
          </p>
          <ul class="service-includes">
            <li>Visita técnica</li>
            <li>Toma de muestras</li>
            <li>Análisis de laboratorio</li>
            <li>Informe detallado</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="cta-section">
      <h3 class="cta-title">¿No encuentras lo que buscas?</h3>
      <p class="cta-description">Contáctanos y estudiaremos tu caso particular sin compromiso</p>
      <a href="#contacto" class="btn btn-primary">Solicitar Información</a>
    </div>
  </div>
</section>

<style>
  .section-alt {
    background: var(--color-bg-light);
  }

  .service-card {
    background: white;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
  }

  .service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
  }

  .service-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
    position: relative;
  }

  .service-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s ease;
  }

  .service-card:hover .service-image img {
    transform: scale(1.05);
  }

  .service-content {
    padding: 2rem;
  }

  .service-title {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .service-description {
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }

  .service-includes {
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  .service-includes li {
    padding-left: 1.5rem;
    position: relative;
    color: var(--color-text-light);
  }

  .service-includes li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-secondary);
    font-weight: bold;
  }

  .cta-section {
    text-align: center;
    margin-top: 4rem;
    padding: 3rem;
    background: white;
    border-radius: 1rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  }

  .cta-title {
    font-size: 2rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .cta-description {
    font-size: 1.25rem;
    color: var(--color-text-light);
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .service-content {
      padding: 1.5rem;
    }

    .cta-section {
      padding: 2rem 1.5rem;
    }

    .cta-title {
      font-size: 1.5rem;
    }
  }
</style>
