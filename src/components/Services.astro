---
---

<section id="servicios" class="section section-alt">
  <div class="container">
    <div class="section-header text-center">
      <h2 class="section-title">Nuestros Servicios de Desamiantado</h2>
      <p class="section-subtitle">
        Soluciones profesionales para todo tipo de estructuras con amianto
      </p>
    </div>

    <div class="grid grid-3">
      <div class="service-card">
        <div class="service-image">
          <svg width="100%" height="200" viewBox="0 0 400 200" fill="none">
            <rect width="400" height="200" fill="#e5e7eb"/>
            <path d="M50 150L200 50L350 150V180H50V150Z" fill="#1e40af"/>
            <rect x="150" y="100" width="100" height="80" fill="#374151"/>
          </svg>
        </div>
        <div class="service-content">
          <h3 class="service-title">Retirada de Tejados de Uralita</h3>
          <p class="service-description">
            Desmontaje seguro de cubiertas de fibrocemento en naves industriales, agrícolas y viviendas. Incluye retirada, embalaje y gestión de residuos.
          </p>
          <ul class="service-includes">
            <li>Inspección previa gratuita</li>
            <li>Desmontaje sin roturas</li>
            <li>Embalaje homologado</li>
            <li>Certificado final</li>
          </ul>
        </div>
      </div>

      <div class="service-card">
        <div class="service-image">
          <svg width="100%" height="200" viewBox="0 0 400 200" fill="none">
            <rect width="400" height="200" fill="#e5e7eb"/>
            <circle cx="200" cy="140" r="50" fill="#1e40af"/>
            <rect x="190" y="60" width="20" height="80" fill="#1e40af"/>
          </svg>
        </div>
        <div class="service-content">
          <h3 class="service-title">Depósitos de Fibrocemento</h3>
          <p class="service-description">
            Retirada de depósitos de agua con amianto, tanto aéreos como enterrados. Trabajo especializado con maquinaria específica.
          </p>
          <ul class="service-includes">
            <li>Vaciado y limpieza previa</li>
            <li>Corte y extracción segura</li>
            <li>Transporte especializado</li>
            <li>Gestión documental</li>
          </ul>
        </div>
      </div>

      <div class="service-card">
        <div class="service-image">
          <svg width="100%" height="200" viewBox="0 0 400 200" fill="none">
            <rect width="400" height="200" fill="#e5e7eb"/>
            <path d="M50 100H350V120H50V100Z" fill="#1e40af"/>
            <path d="M50 140H350V160H50V140Z" fill="#1e40af"/>
          </svg>
        </div>
        <div class="service-content">
          <h3 class="service-title">Tuberías y Conducciones</h3>
          <p class="service-description">
            Eliminación de tuberías de fibrocemento en instalaciones industriales, saneamientos y conducciones de agua.
          </p>
          <ul class="service-includes">
            <li>Detección y análisis</li>
            <li>Confinamiento de zona</li>
            <li>Extracción controlada</li>
            <li>Sellado final</li>
          </ul>
        </div>
      </div>

      <div class="service-card">
        <div class="service-image">
          <svg width="100%" height="200" viewBox="0 0 400 200" fill="none">
            <rect width="400" height="200" fill="#e5e7eb"/>
            <rect x="50" y="50" width="300" height="130" fill="#1e40af"/>
            <rect x="100" y="90" width="60" height="80" fill="#374151"/>
            <rect x="240" y="90" width="60" height="80" fill="#374151"/>
          </svg>
        </div>
        <div class="service-content">
          <h3 class="service-title">Fachadas y Revestimientos</h3>
          <p class="service-description">
            Retirada de placas de amianto en fachadas, revestimientos interiores y falsos techos en edificios.
          </p>
          <ul class="service-includes">
            <li>Protección de áreas colindantes</li>
            <li>Desmontaje por secciones</li>
            <li>Limpieza profunda</li>
            <li>Certificado de salubridad</li>
          </ul>
        </div>
      </div>

      <div class="service-card">
        <div class="service-image">
          <svg width="100%" height="200" viewBox="0 0 400 200" fill="none">
            <rect width="400" height="200" fill="#e5e7eb"/>
            <rect x="100" y="80" width="200" height="80" fill="#1e40af" opacity="0.5"/>
            <path d="M100 80H300V160H100V80Z" stroke="#1e40af" stroke-width="4" fill="none"/>
          </svg>
        </div>
        <div class="service-content">
          <h3 class="service-title">Encapsulado de Amianto</h3>
          <p class="service-description">
            Alternativa cuando la retirada no es viable. Sellado profesional para evitar liberación de fibras.
          </p>
          <ul class="service-includes">
            <li>Evaluación técnica</li>
            <li>Aplicación de sellante</li>
            <li>Control de calidad</li>
            <li>Plan de mantenimiento</li>
          </ul>
        </div>
      </div>

      <div class="service-card">
        <div class="service-image">
          <svg width="100%" height="200" viewBox="0 0 400 200" fill="none">
            <rect width="400" height="200" fill="#e5e7eb"/>
            <circle cx="200" cy="100" r="60" fill="none" stroke="#1e40af" stroke-width="4"/>
            <path d="M200 50L200 90M200 110L200 150M150 100L190 100M210 100L250 100" stroke="#1e40af" stroke-width="4"/>
          </svg>
        </div>
        <div class="service-content">
          <h3 class="service-title">Inspección y Análisis</h3>
          <p class="service-description">
            Identificación y análisis de materiales sospechosos. Informe técnico con recomendaciones y presupuesto.
          </p>
          <ul class="service-includes">
            <li>Visita técnica</li>
            <li>Toma de muestras</li>
            <li>Análisis de laboratorio</li>
            <li>Informe detallado</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="cta-section">
      <h3 class="cta-title">¿No encuentras lo que buscas?</h3>
      <p class="cta-description">Contáctanos y estudiaremos tu caso particular sin compromiso</p>
      <a href="#contacto" class="btn btn-primary">Solicitar Información</a>
    </div>
  </div>
</section>

<style>
  .section-alt {
    background: var(--color-bg-light);
  }

  .service-card {
    background: white;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
  }

  .service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
  }

  .service-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .service-content {
    padding: 2rem;
  }

  .service-title {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .service-description {
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }

  .service-includes {
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  .service-includes li {
    padding-left: 1.5rem;
    position: relative;
    color: var(--color-text-light);
  }

  .service-includes li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-secondary);
    font-weight: bold;
  }

  .cta-section {
    text-align: center;
    margin-top: 4rem;
    padding: 3rem;
    background: white;
    border-radius: 1rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  }

  .cta-title {
    font-size: 2rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .cta-description {
    font-size: 1.25rem;
    color: var(--color-text-light);
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .service-content {
      padding: 1.5rem;
    }

    .cta-section {
      padding: 2rem 1.5rem;
    }

    .cta-title {
      font-size: 1.5rem;
    }
  }
</style>
