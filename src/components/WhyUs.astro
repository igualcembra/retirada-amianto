---
---

<section id="por-que-elegirnos" class="section">
  <div class="container">
    <div class="section-header text-center">
      <h2 class="section-title">¿Por Qué Confiar En Nosotros?</h2>
      <p class="section-subtitle">
        Somos especialistas certificados en desamiantado con años de experiencia
      </p>
    </div>

    <div class="grid grid-3">
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="feature-title">Experiencia Profesional</h3>
        <p class="feature-description">
          Equipo con años de experiencia en desamiantado. Cumplimos rigurosamente toda la normativa vigente de seguridad y salud.
        </p>
      </div>

      <div class="feature-card">
        <div class="feature-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="feature-title">Equipo Especializado</h3>
        <p class="feature-description">
          Operarios formados y equipados con EPIs certificados. Máxima seguridad en cada trabajo.
        </p>
      </div>

      <div class="feature-card">
        <div class="feature-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="feature-title">Gestión Completa</h3>
        <p class="feature-description">
          Nos encargamos de todo: análisis, retirada, transporte y gestión legal de residuos en vertedero autorizado.
        </p>
      </div>

      <div class="feature-card">
        <div class="feature-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="feature-title">Respuesta Rápida</h3>
        <p class="feature-description">
          Presupuesto en menos de 24 horas. Trabajos urgentes atendidos con prioridad.
        </p>
      </div>

      <div class="feature-card">
        <div class="feature-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="feature-title">Precios Competitivos</h3>
        <p class="feature-description">
          Sin letra pequeña. Precio cerrado con todo incluido: retirada, transporte y gestión de residuos.
        </p>
      </div>

      <div class="feature-card">
        <div class="feature-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="feature-title">Seguro RC</h3>
        <p class="feature-description">
          Seguro de responsabilidad civil con cobertura amplia. Tu tranquilidad es nuestra prioridad.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding: 5rem 0;
  }

  .section-header {
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .section-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-light);
    max-width: 600px;
    margin: 0 auto;
  }

  .feature-card {
    text-align: center;
    padding: 2rem;
  }

  .feature-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 1.5rem;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    box-shadow: 0 4px 14px rgba(14, 165, 233, 0.25);
    transition: all 0.3s ease;
  }

  .feature-card:hover .feature-icon {
    transform: scale(1.1);
    box-shadow: 0 8px 20px rgba(14, 165, 233, 0.35);
  }

  .feature-title {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .feature-description {
    color: var(--color-text-light);
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .section {
      padding: 3rem 0;
    }

    .section-title {
      font-size: 2rem;
    }

    .section-subtitle {
      font-size: 1.1rem;
    }
  }
</style>
