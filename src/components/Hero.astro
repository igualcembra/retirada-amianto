---
---

<section class="hero">
  <div class="hero-background">
    <img
      src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1920&auto=format&fit=crop&q=80"
      alt="Trabajadores en obra de construcción"
      class="hero-bg-image"
    />
    <div class="hero-overlay"></div>
  </div>

  <div class="container">
    <div class="hero-content">
      <div class="hero-text">
        <div class="hero-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Empresa Certificada RERA</span>
        </div>

        <h1 class="hero-title">Retirada De Amianto</h1>

        <p class="hero-subtitle">
          Empresa especializada en retirada de amianto y uralita con todas las certificaciones oficiales.
          <strong class="hero-highlight">Presupuesto sin compromiso en 24h.</strong>
        </p>

        <ul class="hero-features">
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <polyline points="20 6 9 17 4 12" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Empresa certificada RERA</span>
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <polyline points="20 6 9 17 4 12" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Seguro de responsabilidad civil</span>
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <polyline points="20 6 9 17 4 12" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Gestión de residuos incluida</span>
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <polyline points="20 6 9 17 4 12" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Cobertura en toda España</span>
          </li>
        </ul>

        <div class="hero-stats">
          <div class="stat">
            <div class="stat-number">+500</div>
            <div class="stat-label">Proyectos completados</div>
          </div>
          <div class="stat">
            <div class="stat-number">24h</div>
            <div class="stat-label">Tiempo de respuesta</div>
          </div>
          <div class="stat">
            <div class="stat-number">100%</div>
            <div class="stat-label">Satisfacción cliente</div>
          </div>
        </div>
      </div>

      <div class="hero-form-wrapper">
        <div class="form-card">
          <div class="form-header">
            <h2 class="form-title">Solicita tu presupuesto gratis</h2>
            <p class="form-subtitle">Te respondemos en menos de 24 horas</p>
          </div>

          <form id="contact-form" class="contact-form">
            <div class="form-group">
              <label for="nombre" class="form-label">Nombre completo *</label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                class="form-input"
                required
                placeholder="Ej: Juan García"
              />
            </div>

            <div class="form-group">
              <label for="email" class="form-label">Email *</label>
              <input
                type="email"
                id="email"
                name="email"
                class="form-input"
                required
                placeholder="ejemplo@email.com"
              />
            </div>

            <div class="form-group">
              <label for="telefono" class="form-label">Teléfono *</label>
              <input
                type="tel"
                id="telefono"
                name="telefono"
                class="form-input"
                required
                placeholder="Ej: 600 123 456"
              />
            </div>

            <div class="form-group">
              <label for="ubicacion" class="form-label">Ubicación (ciudad/provincia) *</label>
              <input
                type="text"
                id="ubicacion"
                name="ubicacion"
                class="form-input"
                required
                placeholder="Ej: Madrid, Barcelona..."
              />
            </div>

            <div class="form-group">
              <label for="servicio" class="form-label">Tipo de servicio *</label>
              <select id="servicio" name="servicio" class="form-select" required>
                <option value="">Selecciona un servicio</option>
                <option value="retirada-tejado">Retirada de tejado de uralita</option>
                <option value="retirada-deposito">Retirada de depósito de fibrocemento</option>
                <option value="retirada-tuberias">Retirada de tuberías</option>
                <option value="retirada-fachada">Retirada de fachada</option>
                <option value="encapsulado">Encapsulado de amianto</option>
                <option value="inspeccion">Inspección y análisis</option>
                <option value="otro">Otro servicio</option>
              </select>
            </div>

            <div class="form-group">
              <label for="mensaje" class="form-label">Mensaje (opcional)</label>
              <textarea
                id="mensaje"
                name="mensaje"
                class="form-textarea"
                placeholder="Cuéntanos más detalles sobre tu proyecto..."
              ></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-block">
              <span class="btn-text">Solicitar Presupuesto Gratis</span>
              <span class="btn-loading" style="display: none;">
                <span class="spinner"></span> Enviando...
              </span>
            </button>

            <p class="form-privacy">
              🔒 Al enviar este formulario aceptas nuestra política de privacidad.
              Tus datos están 100% protegidos.
            </p>
          </form>

          <div id="form-success" class="alert alert-success" style="display: none;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <polyline points="22 4 12 14.01 9 11.01" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <div>
              <strong>¡Mensaje enviado!</strong>
              <p>Te contactaremos en menos de 24 horas.</p>
            </div>
          </div>

          <div id="form-error" class="alert alert-error" style="display: none;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <circle cx="12" cy="12" r="10" stroke-width="2"/>
              <line x1="12" y1="8" x2="12" y2="12" stroke-width="2" stroke-linecap="round"/>
              <line x1="12" y1="16" x2="12.01" y2="16" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <div>
              <strong>Error</strong>
              <p>No se pudo enviar el mensaje. Por favor, inténtalo de nuevo.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Decoración ondulada al final del hero -->
  <div class="hero-waves">
    <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 0L60 10C120 20 240 40 360 46.7C480 53 600 47 720 43.3C840 40 960 40 1080 46.7C1200 53 1320 67 1380 73.3L1440 80V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0V0Z" fill="white"/>
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 8rem 0 6rem;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      rgba(14, 165, 233, 0.95) 0%,
      rgba(2, 132, 199, 0.92) 50%,
      rgba(3, 105, 161, 0.90) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 5rem;
    align-items: start;
  }

  .hero-text {
    color: white;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    padding: 0.5rem 1rem;
    border-radius: 2rem;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .hero-badge svg {
    color: #fbbf24;
  }

  .hero-title {
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 900;
    margin-bottom: 1.5rem;
    line-height: 1.1;
    color: white;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    margin-bottom: 2.5rem;
    opacity: 0.95;
    line-height: 1.7;
    max-width: 600px;
  }

  .hero-highlight {
    display: block;
    margin-top: 0.5rem;
    color: #fbbf24;
    font-size: 1.4rem;
  }

  .hero-features {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .hero-features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.05rem;
    font-weight: 500;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    padding: 0.875rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.3s ease;
  }

  .hero-features li:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: translateX(5px);
  }

  .hero-features svg {
    flex-shrink: 0;
    color: #10b981;
    filter: drop-shadow(0 0 8px rgba(16, 185, 129, 0.5));
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .stat {
    text-align: center;
  }

  .stat-number {
    font-size: 2.5rem;
    font-weight: 900;
    color: #fbbf24;
    line-height: 1;
    margin-bottom: 0.5rem;
    text-shadow: 0 2px 10px rgba(251, 191, 36, 0.3);
  }

  .stat-label {
    font-size: 0.875rem;
    opacity: 0.9;
    font-weight: 500;
  }

  .form-card {
    background: white;
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .form-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .form-title {
    color: var(--color-text);
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .form-subtitle {
    color: var(--color-text-light);
    font-size: 1rem;
  }

  .btn-block {
    width: 100%;
    justify-content: center;
  }

  .form-privacy {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: 1rem;
    line-height: 1.5;
  }

  .alert {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: var(--radius-md);
    margin-top: 1.5rem;
    font-size: 0.9375rem;
  }

  .alert svg {
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .alert strong {
    display: block;
    margin-bottom: 0.25rem;
  }

  .alert p {
    margin: 0;
    opacity: 0.9;
  }

  .alert-success {
    background: #d1fae5;
    color: #065f46;
    border: 2px solid #059669;
  }

  .alert-success svg {
    color: #059669;
  }

  .alert-error {
    background: #fee2e2;
    color: #991b1b;
    border: 2px solid #dc2626;
  }

  .alert-error svg {
    color: #dc2626;
  }

  .hero-waves {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    line-height: 0;
    z-index: 1;
  }

  .hero-waves svg {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 1024px) {
    .hero-content {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero-stats {
      grid-template-columns: repeat(3, 1fr);
    }

    .stat-number {
      font-size: 2rem;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 6rem 0 4rem;
      min-height: auto;
    }

    .hero-title {
      font-size: 2.5rem;
    }

    .hero-subtitle {
      font-size: 1.1rem;
    }

    .hero-highlight {
      font-size: 1.2rem;
    }

    .hero-features {
      grid-template-columns: 1fr;
    }

    .hero-stats {
      gap: 1.5rem;
    }

    .stat-number {
      font-size: 1.75rem;
    }

    .stat-label {
      font-size: 0.8125rem;
    }

    .form-card {
      padding: 2rem 1.5rem;
    }

    .form-title {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successAlert = document.getElementById('form-success') as HTMLElement;
    const errorAlert = document.getElementById('form-error') as HTMLElement;
    const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement;
    const btnText = submitBtn?.querySelector('.btn-text') as HTMLElement;
    const btnLoading = submitBtn?.querySelector('.btn-loading') as HTMLElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!submitBtn || !btnText || !btnLoading) return;

      // Mostrar loading
      submitBtn.disabled = true;
      btnText.style.display = 'none';
      btnLoading.style.display = 'inline-flex';

      // Ocultar mensajes previos
      if (successAlert) successAlert.style.display = 'none';
      if (errorAlert) errorAlert.style.display = 'none';

      // Recoger datos del formulario
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          // Mostrar mensaje de éxito
          if (successAlert) successAlert.style.display = 'flex';
          form.reset();

          // Scroll al mensaje
          successAlert?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
          throw new Error('Error al enviar');
        }
      } catch (error) {
        // Mostrar mensaje de error
        if (errorAlert) errorAlert.style.display = 'flex';
        errorAlert?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } finally {
        // Restaurar botón
        submitBtn.disabled = false;
        btnText.style.display = 'inline';
        btnLoading.style.display = 'none';
      }
    });
  });
</script>
